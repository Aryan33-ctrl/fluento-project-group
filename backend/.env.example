NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/fluento
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
DISABLE_AUTH=true
# Groq transcription
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
# Gemini evaluation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# OpenAI vars kept for backward compatibility
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EVAL_MODEL=gpt-4o-mini
# Private audio storage (shared between API and worker)
STORAGE_DIR=./private-storage
MAX_AUDIO_MB=25
# SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fluento <no-reply@fluento.app>
APP_URL=http://localhost:5173
